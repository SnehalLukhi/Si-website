PORT=5000
MONGODB_URI=mongodb://localhost:27017/sahajanand

# Admin login: random secret (32+ characters) that signs login tokens, and the admin app address used in password-reset emails
JWT_SECRET=replace-with-a-long-random-string
ADMIN_APP_URL=http://localhost:5174

# All emails the site sends (contact form, job applications, service-page forms, admin password reset) go through Resend.
# The API key stays on the backend only. CONTACT_EMAIL_FROM must be on a domain verified in the Resend dashboard.
# Notifications are delivered to CONTACT_EMAIL_TO; the password-reset email goes to the admin's own address.
